  "item": [
    {
      "id": "9ec53e99-1797-4e4d-9675-f370b5739955",
      "name": "Channels",
      "description": {
        "content": "Discovery of the content channels a partner is entitled to consume.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "25d1d4ad-fcda-4679-9edb-b7031308a837",
          "name": "List content channels",
          "request": {
            "name": "List content channels",
            "description": {
              "content": "Returns the list of content channels the partner is entitled to consume for a language. A channel has a name and a `contentUrl` used to fetch its cards. Setting `pfm=64` returns the DailyShare (viral) channels instead of the standard news channels.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "syndication",
                "channels"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "partner",
                  "value": "<string>",
                  "description": "(Required) The partner identification code issued by Dailyhunt at onboarding."
                },
                {
                  "disabled": false,
                  "key": "langCode",
                  "value": "<string>",
                  "description": "Content language code — one of en, hi, mr, gu, pa, bn, kn, ta, te, ml, or, ur, bh, ne."
                },
                {
                  "disabled": false,
                  "key": "ts",
                  "value": "<long>",
                  "description": "(Required) Current client timestamp in milliseconds; must be included in the signed parameter set."
                },
                {
                  "disabled": false,
                  "key": "puid",
                  "value": "<string>",
                  "description": "(Required) The partner's unique id for the end user accessing the API (for example a device identifier). Dailyhunt maps it to an internal user id to personalize the feed."
                },
                {
                  "disabled": false,
                  "key": "pfm",
                  "value": "<integer>",
                  "description": "Partner feature mask — the sum of the feature bits enabled for the partner or channel. LIVE_TV_CARD 1, CRICKET_CARD (brief) 8, HERO_CARD 16, VIDEO_CHANNELS 32, VIRAL_CHANNELS 64, CRICKET_CARD (detailed) 128. Bits 2 and 4 are reserved."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Number of records per page."
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "<integer>",
                  "description": "Zero-based page number of the paginated response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
