{
  "item": [
    {
      "id": "218a5329-074b-45bb-8132-f7dd1973d5ae",
      "name": "Content Fetch",
      "description": {
        "content": "Paginated retrieval of the content cards inside a channel, plus keyword search.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b6899fa1-6fcc-4f19-a2ff-a8792202f747",
          "name": "Fetch content cards from a channel",
          "request": {
            "name": "Fetch content cards from a channel",
            "description": {
              "content": "Returns the paginated content cards (stories, videos, photos, DailyShare cards, banners, polls, HTML cards) for the channel identified by `cid`. Callers should prefer the `contentUrl` returned by the Channels API, which already carries the correct `fm` for the channel, and follow `nextPageUrl` for pagination. The response also carries the `trackUrl` and per-card `trackData` that must be POSTed back to the Tracking API.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "syndication",
                "items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "partner",
                  "value": "<string>",
                  "description": "(Required) The partner identification code issued by Dailyhunt at onboarding."
                },
                {
                  "disabled": false,
                  "key": "cid",
                  "value": "<string>",
                  "description": "(Required) Channel id whose content cards should be returned."
                },
                {
                  "disabled": false,
                  "key": "langCode",
                  "value": "<string>",
                  "description": "Content language code — one of en, hi, mr, gu, pa, bn, kn, ta, te, ml, or, ur, bh, ne."
                },
                {
                  "disabled": false,
                  "key": "ts",
                  "value": "<long>",
                  "description": "(Required) Current client timestamp in milliseconds; must be included in the signed parameter set."
                },
                {
                  "disabled": false,
                  "key": "puid",
                  "value": "<string>",
                  "description": "(Required) The partner's unique id for the end user accessing the API (for example a device identifier). Dailyhunt maps it to an internal user id to personalize the feed."
                },
                {
                  "disabled": false,
                  "key": "pfm",
                  "value": "<integer>",
                  "description": "Partner feature mask — the sum of the feature bits enabled for the partner or channel. LIVE_TV_CARD 1, CRICKET_CARD (brief) 8, HERO_CARD 16, VIDEO_CHANNELS 32, VIRAL_CHANNELS 64, CRICKET_CARD (detailed) 128. Bits 2 and 4 are reserved."
                },
                {
                  "disabled": false,
                  "key": "fm",
                  "value": "<integer>",
                  "description": "Channel-level feature mask. Inherited from the channel `contentUrl`; only override when a specific change is needed for one channel."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Field selection modifier as published in the reference (for example `none`)."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Number of records per page."
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "<integer>",
                  "description": "Zero-based page number of the paginated response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
