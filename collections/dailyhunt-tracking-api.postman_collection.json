      "id": "eaa7943d-3c68-451d-88ff-226848b8f36c",
      "name": "Tracking",
      "description": {
        "content": "Partner callback reporting which cards a user actually saw.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "352424b9-e3c8-4204-bb4c-c588dcb8b310",
          "name": "Report cards seen by the user",
          "request": {
            "name": "Report cards seen by the user",
            "description": {
              "content": "Reports the cards a user actually saw. The partner posts an array of `{id, trackData}` pairs (the `trackData` value comes verbatim from the card in the Content Fetch response) together with the view timestamp. Callers should POST to the `trackUrl` returned by the Content Fetch API, appending `partner`, `puid` and `ts`, once per list view.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "syndication",
                "tracking"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "partner",
                  "value": "<string>",
                  "description": "(Required) The partner identification code issued by Dailyhunt at onboarding."
                },
                {
                  "disabled": false,
                  "key": "puid",
                  "value": "<string>",
                  "description": "(Required) The partner's unique id for the end user accessing the API (for example a device identifier). Dailyhunt maps it to an internal user id to personalize the feed."
                },
                {
                  "disabled": false,
                  "key": "ts",
                  "value": "<long>",
                  "description": "(Required) Current client timestamp in milliseconds; must be included in the signed parameter set."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"viewedDate\": \"<long>\",\n  \"stories\": [\n    {\n      \"id\": \"<string>\",\n      \"trackData\": \"<string>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"trackData\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
